{
  "name": "cailloute",
  "version": "0.1.63",
  "description": "Cailloute — sorties en famille",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android && node scripts/slim-native-assets.mjs",
    "android:open": "cap open android",
    "predev": "node scripts/prepare-photo-runtime.mjs && node scripts/prepare-local-tiles.mjs",
    "prebuild": "node scripts/clean-build-output.mjs && node scripts/prepare-photo-runtime.mjs && node scripts/prepare-local-tiles.mjs && node scripts/prepare-catalog-hashes.mjs",
    "test:free-rules": "cd .. && firebase emulators:exec --only firestore --project demo-cailloute-free \"cd app && node scripts/test-free-rules.mjs\"",
    "catalog:groups": "node scripts/build-place-groups.mjs",
    "catalog:clean": "node scripts/clean-place-data.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@fontsource/manrope": "5.3.0",
    "dexie": "4.4.5",
    "dexie-react-hooks": "4.4.0",
    "exifr": "7.1.3",
    "firebase": "^12.19.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.43.0",
    "onnxruntime-web": "1.30.0",
    "opening_hours": "3.14.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "supercluster": "9.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/supercluster": "7.1.3",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "private": true,
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
