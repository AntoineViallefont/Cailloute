# Développement local : SQLite et photos dans var/, sans service facturable.
# ENVIRONMENT=production active PostgreSQL, GCS et le contrôle de licence.
# DATABASE_URL=postgresql+psycopg://cailloute:SECRET@HOST:5432/cailloute
# PHOTO_BUCKET=VOTRE_BUCKET_GCS
# CORS_ORIGINS=https://localhost,https://VOTRE_PROJET.web.app
# WEATHER_API=https://api.open-meteo.com/v1/forecast
# AIR_API=https://air-quality-api.open-meteo.com/v1/air-quality

# Mail : secrets uniquement sur le serveur (jamais VITE_*).
# CONTACT_TO=adresse-destinataire
# SMTP_HOST=smtp.votre-fournisseur.fr
# SMTP_PORT=465
# SMTP_FROM=adresse-expediteur-verifiee
# SMTP_USER=identifiant
# SMTP_PASSWORD=mot-de-passe-application
# IDENTITY_SECRET=secret-aleatoire-persistant-d-au-moins-32-caracteres
# PUBLIC_API_URL=https://VOTRE_SERVICE.run.app
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_GRAPH_VERSION=version-supportee-par-votre-application-Meta
